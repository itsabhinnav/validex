{
  "app": {
    "name": "Validex",
    "version": "1.0.0",
    "description": " Test Case Management Platform",
    "tagline": "Quality Assurance Management System",
    "debug": true,
    "secret_key": "dev-secret-key-change-in-production",
    "host": "127.0.0.1",
    "port": 8000,
    "admin_enabled": false,
    "sakura_enabled": true,
    "multiselect_threshold": 5,
