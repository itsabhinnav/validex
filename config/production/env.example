# Validex Production Environment Configuration
# Copy this file to .env and update the values

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-super-secret-production-key-change-this

# Database Configuration
DATABASE_URL=sqlite:///data/test_cases.db

# File Storage
UPLOAD_FOLDER=data/excel_files
REPORTS_FOLDER=data/reports

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security Settings
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Performance Settings
MAX_CONTENT_LENGTH=104857600  # 100MB in bytes

# JFrog Artifactory Integration (Optional)
JFROG_BASE_URL=https://your-artifactory.com
JFROG_REPOSITORY=your-repo
JFROG_ROOT_PATH=test-cases
JFROG_ACCESS_TOKEN=your-access-token
JFROG_ENABLED=False

# Email Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379/0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Monitoring Configuration
HEALTH_CHECK_INTERVAL=300  # 5 minutes
MONITORING_ENABLED=True
